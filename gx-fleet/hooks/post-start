#!/usr/bin/env bash
set -euo pipefail
umask 077
: "${APP_DATA_ROOT:?Umbrel app data root is required}"
: "${APP_FLEET_ADMIN_PASSWORD:?Fleet initial admin password is required}"

# This native hook runs on the Umbrel host. No Fleet container receives the
# Docker socket, host networking, privileges or access to Tailscale state.
ts() { docker exec tailscale_web_1 tailscale "$@"; }
status_file="${APP_DATA_ROOT}/integration-status"
printf 'starting\n' > "${status_file}"
chmod 644 "${status_file}"
node_status="$(ts status --json)"
node_name="$(jq -er '.Self.DNSName | rtrimstr(".") | select(length > 0)' <<< "${node_status}")"
[[ "${node_name}" == *.ts.net ]] || { echo 'Fleet: invalid Tailscale DNS name' >&2; exit 1; }
public_url="https://${node_name}:8272"

# Refuse to take over someone else's Serve mapping. Update only this port;
# never reset Serve or change its existing HTTPS root on port 443.
serve_status="$(ts serve status --json)"
existing="$(jq -r --arg key "${node_name}:8272" '.Web[$key].Handlers["/"].Proxy // empty' <<< "${serve_status}")"
port_exists="$(jq -r '.TCP["8272"] != null' <<< "${serve_status}")"
if [[ "${port_exists}" == true && "${existing}" != http://127.0.0.1:13379 ]]; then
  echo 'Fleet: Tailscale HTTPS port 8272 is already assigned to another service' >&2
  printf 'failed: HTTPS port conflict\n' > "${status_file}"
  exit 1
fi

ready=false
for attempt in $(seq 1 90); do
  if curl --fail --silent --show-error --max-time 3 http://127.0.0.1:13379/healthz >/dev/null; then
    ready=true
    break
  fi
  sleep 2
done
[[ "${ready}" == true ]] || { printf 'failed: Fleet health timeout\n' > "${status_file}"; exit 1; }

# Fleet redirects /setup to /login once an administrator exists. A marker
# makes the two-stage first bootstrap recoverable if the response or config
# update is interrupted. Established installations without this marker retain
# their administrator, password and server URL unchanged.
pending="${APP_DATA_ROOT}/bootstrap-pending"
payload="$(mktemp "${APP_DATA_ROOT}/.setup-request.XXXXXX")"
response="$(mktemp "${APP_DATA_ROOT}/.setup-response.XXXXXX")"
auth_header="$(mktemp "${APP_DATA_ROOT}/.setup-header.XXXXXX")"
cleanup() {
  result=$?
  rm -f -- "${payload}" "${response}" "${auth_header}"
  if [[ "${result}" != 0 ]]; then
    printf 'failed: bootstrap or HTTPS integration\n' > "${status_file}"
  fi
  return "${result}"
}
trap cleanup EXIT
setup_code="$(curl --silent --max-time 10 --output /dev/null --write-out '%{http_code}' http://127.0.0.1:13379/setup)"
if [[ "${setup_code}" == 200 ]]; then
  touch "${pending}"
  # Setup applies the starter library synchronously, via Fleet's own loopback.
  jq -n --arg password "${APP_FLEET_ADMIN_PASSWORD}" --arg url "http://127.0.0.1:1337" \
    '{admin:{name:"Guilherme",email:"admin@fleet.local",password:$password},org_info:{org_name:"Guilherme"},server_url:$url}' > "${payload}"
  curl --fail --silent --show-error --max-time 120 -H 'Content-Type: application/json' \
    --data-binary "@${payload}" --output "${response}" http://127.0.0.1:13379/api/v1/setup
  jq -e '.admin.email == "admin@fleet.local"' "${response}" >/dev/null
elif [[ "${setup_code}" != 307 && "${setup_code}" != 302 ]]; then
  echo 'Fleet: unexpected setup response' >&2
  exit 1
fi

if [[ -f "${pending}" ]]; then
  if ! jq -e '.token | type == "string" and length > 0' "${response}" >/dev/null 2>&1; then
    # Only an unfinished first bootstrap uses the initial generated password.
    # If the owner changed it, fail closed rather than reset that account.
    jq -n --arg password "${APP_FLEET_ADMIN_PASSWORD}" \
      '{email:"admin@fleet.local",password:$password}' > "${payload}"
    curl --fail --silent --show-error --max-time 30 -H 'Content-Type: application/json' \
      --data-binary "@${payload}" --output "${response}" http://127.0.0.1:13379/api/v1/fleet/login
  fi
  jq -er '"Authorization: Bearer " + (.token | select(type == "string" and length > 0))' "${response}" > "${auth_header}"
  jq -n --arg url "${public_url}" '{server_settings:{server_url:$url}}' > "${payload}"
  curl --fail --silent --show-error --max-time 30 -X PATCH -H 'Content-Type: application/json' \
    --header "@${auth_header}" --data-binary "@${payload}" --output "${response}" \
    http://127.0.0.1:13379/api/v1/fleet/config
  jq -e --arg url "${public_url}" '(.server_settings.server_url // .config.server_settings.server_url) == $url' "${response}" >/dev/null
  rm -f -- "${pending}"
fi
# Publish only after an administrator exists, so first-time setup is never
# reachable by other tailnet peers.
ts serve --bg --https=8272 http://127.0.0.1:13379
printf '%s\n' "${public_url}" > "${APP_DATA_ROOT}/public-url"
chmod 644 "${APP_DATA_ROOT}/public-url"
printf 'owned\n' > "${APP_DATA_ROOT}/tailscale-8272-owned"
printf 'ready\n' > "${status_file}"
echo "Fleet ready at ${public_url}; administrator credentials are available in Umbrel."
